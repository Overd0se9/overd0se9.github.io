---
const path = Astro.url.pathname;
const is = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
---

<header class="site-header">
  <nav class="nav" aria-label="Main">
    <a class="brand" href="/" aria-label="overd0se home">
      <span class="dot" aria-hidden="true"></span><span>overd<span class="z">0</span>se</span>
    </a>
    <div class="nav-links">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Cases</a>
      <a href="/archive" aria-current={is('/archive')}>Archive</a>
      <a href="/tags" aria-current={is('/tags')}>Tags</a>
      <a href="/about" aria-current={is('/about')}>About</a>
    </div>
  </nav>
</header>
