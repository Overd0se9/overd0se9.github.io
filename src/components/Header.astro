---
import { SITE } from '../consts';
const path = Astro.url.pathname;
const is = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
---

<header class="site-header">
  <nav class="nav">
    <a class="brand" href="/">
      <span class="prompt">~/</span>{SITE.title}<span class="cursor">_</span>
    </a>
    <div class="nav-links">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>home</a>
      <a href="/archive" aria-current={is('/archive')}>archive</a>
      <a href="/tags" aria-current={is('/tags')}>tags</a>
      <a href="/about" aria-current={is('/about')}>about</a>
      <a href={SITE.github} target="_blank" rel="noopener">github</a>
    </div>
  </nav>
</header>
