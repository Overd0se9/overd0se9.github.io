---
import { CATEGORIES, readingMinutes } from '../consts';
import { caseNumber, causeOf, isoDate } from '../lib/cases';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { title, date, category, excerpt, tags } = post.data;
const cat = CATEGORIES[category];
const no = await caseNumber(post);
const searchBlob = [title, excerpt, category, post.data.cve ?? '', tags.join(' ')].join(' ').toLowerCase();
---

<li class="post-row" data-cat={category} data-search={searchBlob}>
  <div class="case-tag">
    <span class="no">Case #{no}</span>
    <span class="cls">{cat.numeral} · {cat.label}</span>
  </div>
  <div>
    <a class="pr-link" href={`/posts/${post.id}/`}><h3 class="pr-title">{title}</h3></a>
    <p class="pr-ex">{excerpt}</p>
    {tags.length > 0 && (
      <div class="pr-tags">
        {tags.slice(0, 5).map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}
      </div>
    )}
  </div>
  <dl class="case-dl">
    <div><dt>Time of death</dt><dd><time datetime={isoDate(date)}>{isoDate(date)}</time></dd></div>
    <div><dt>Cause</dt><dd>{causeOf(post)}</dd></div>
    <div><dt>Exam time</dt><dd>{readingMinutes(post.body)} min</dd></div>
  </dl>
</li>
