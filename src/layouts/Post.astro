---
import Base from './Base.astro';
import { CATEGORIES } from '../consts';
import { caseNumber, causeOf, isoDate } from '../lib/cases';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
  readingTime: number;
}
const { post, prev, next, readingTime } = Astro.props;
const { title, date, category, excerpt, tags, cve, platform, difficulty, updated } = post.data;
const cat = CATEGORIES[category];
const no = await caseNumber(post);
---

<Base title={title} description={excerpt}>
  <div class="autopsy">
    <article class="article-body">
      <header class="article-head">
        <span class="eyebrow">Case #{no} · {cat.numeral} · {cat.label}</span>
        <h1>{title}</h1>
        <p class="ex">{excerpt}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>

    <aside class="chart" aria-label="Case details">
      <div>Time of death<b><time datetime={isoDate(date)}>{isoDate(date)}</time></b></div>
      {updated && <div>Re-examined<b>{isoDate(updated)}</b></div>}
      <div>Cause<b>{causeOf(post)}</b></div>
      {cve && <div>CVE<b>{cve}</b></div>}
      {platform && <div>Venue<b>{platform}</b></div>}
      {difficulty && <div>Severity<b>{difficulty}</b></div>}
      <div>Exam time<b>{readingTime} min read</b></div>
      {tags.length > 0 && (
        <div>Tissue samples
          <span class="tags">{tags.map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}</span>
        </div>
      )}
    </aside>
  </div>

  <nav class="pager" aria-label="More cases">
    {prev ? (
      <a class="prv" href={`/posts/${prev.id}/`}><small>Older case</small>{prev.data.title}</a>
    ) : <span></span>}
    {next && (
      <a class="nxt" href={`/posts/${next.id}/`}><small>Newer case</small>{next.data.title}</a>
    )}
  </nav>
</Base>
