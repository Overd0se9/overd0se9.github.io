---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import Ecg from '../components/Ecg.astro';
import { SITE, CATEGORIES, type Category } from '../consts';
import { getPosts } from '../lib/cases';

const posts = await getPosts();
const count = (c: string) => posts.filter((p) => p.data.category === c).length;
const cats = Object.entries(CATEGORIES) as [Category, (typeof CATEGORIES)[Category]][];
---

<Base>
  <section class="hero">
    <Ecg />
    <h1>overd<span class="z">0</span>se</h1>
    <div class="hero-sub">
      <p>{SITE.tagline} by {SITE.author}. Notes from real engagements, lab boxes and late nights reading disassembly.</p>
      <p class="epitaph">“Every system dies the same way. Someone trusted an input they should have questioned.”</p>
    </div>
  </section>

  <section class="wrap wrap-wide">
    <div class="sec"><h2>Causes of death</h2><span class="mono-label">Pick one to filter</span></div>
    <div class="causes" id="causes">
      {cats.map(([key, c]) => (
        <button class="cause" type="button" data-f={key} aria-pressed="false">
          <span class="n">{c.numeral} · {key}</span>
          <b>{c.label}</b>
          <small>{c.blurb}</small>
          <span class="cnt">{count(key)} case{count(key) === 1 ? '' : 's'}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="wrap wrap-wide" id="posts">
    <div class="sec"><h2>Case files</h2><span class="mono-label">{posts.length} bodies on the slab</span></div>
    <div class="tools">
      <div class="filters" id="filters">
        <button class="on" data-f="all">All</button>
        {cats.map(([key, c]) => <button data-f={key}>{c.label}</button>)}
      </div>
      <label class="search">
        <span class="sr">Search posts</span>
        <input id="q" type="search" placeholder="Search cases  ( / )" autocomplete="off" />
      </label>
    </div>

    <ul class="posts" id="list">
      {posts.map((post) => <PostRow post={post} />)}
    </ul>
    <p class="empty" id="noresults" hidden>No cases match. Clear the filter or try another search.</p>
  </section>
</Base>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLLIElement>('.post-row'));
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#filters button'));
  const causeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#causes .cause'));
  const q = document.getElementById('q') as HTMLInputElement | null;
  const noResults = document.getElementById('noresults');
  let active = 'all';

  function apply() {
    const term = (q?.value || '').trim().toLowerCase();
    let shown = 0;
    rows.forEach((row) => {
      const ok = (active === 'all' || row.dataset.cat === active) && (!term || (row.dataset.search || '').includes(term));
      row.hidden = !ok;
      if (ok) shown++;
    });
    if (noResults) noResults.hidden = shown !== 0;
    filterBtns.forEach((b) => b.classList.toggle('on', b.dataset.f === active));
    causeBtns.forEach((b) => {
      const on = b.dataset.f === active;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
  }

  filterBtns.forEach((b) => b.addEventListener('click', () => { active = b.dataset.f || 'all'; apply(); }));
  causeBtns.forEach((b) => b.addEventListener('click', () => {
    active = active === b.dataset.f ? 'all' : b.dataset.f || 'all';
    apply();
    document.getElementById('posts')?.scrollIntoView({ behavior: 'smooth' });
  }));
  q?.addEventListener('input', apply);
  document.addEventListener('keydown', (e) => {
    const tag = (document.activeElement as HTMLElement | null)?.tagName;
    if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') { e.preventDefault(); q?.focus(); }
  });
</script>
