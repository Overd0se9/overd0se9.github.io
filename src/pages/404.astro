---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <section class="wrap page prose" style="text-align:center; padding-top:5rem">
    <p style="font-family:var(--mono); color:var(--accent); font-size:3rem; margin:0">404</p>
    <h1>segmentation fault</h1>
    <p style="color:var(--fg-dim)">That path dereferenced nothing. The page you're after doesn't exist.</p>
    <p><a class="btn ghost" href="/">← back to home</a></p>
  </section>
</Base>
